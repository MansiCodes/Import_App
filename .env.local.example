# ==============================================================================
# Supabase Configuration
# ==============================================================================

# Option A: Automated setup using `npm run db:setup`
# Generate an access token at https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# (Optional) If you belong to multiple Supabase organisations, specify the Org ID:
# SUPABASE_ORG_ID=
# SUPABASE_PROJECT_NAME=notofire-import-tower
# SUPABASE_REGION=ap-south-1

# Option B: Manual configuration (or auto-populated after running `npm run db:setup`)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Database connection string (Supavisor pooler in Session mode, port 5432)
# Used by migrations (`npm run db:apply`) and verification (`npm run db:verify`)
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Initial admin, used only by `npm run auth:seed`. Never expose these to the browser.
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=choose-a-long-password
# INITIAL_ADMIN_NAME=Admin

# Password-reset email. Login itself does not send mail.
# AUTH_SMTP_HOST=smtp.example.com
# AUTH_SMTP_PORT=587
# AUTH_SMTP_USER=
# AUTH_SMTP_PASSWORD=
# AUTH_SMTP_FROM=Import Control Tower <noreply@example.com>
# AUTH_SMTP_SECURE=false
# AUTH_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# WhatsApp Cloud API (optional). Freight quote links still work without this:
# Copy link / Open WhatsApp remain available. Direct "Send WhatsApp" needs both
# access token and phone number id. Never prefix these with NEXT_PUBLIC_.
#
# WHATSAPP_PROVIDER=meta_cloud
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_API_VERSION=v21.0
# WHATSAPP_QUOTE_TEMPLATE_NAME=freight_quote_request
# WHATSAPP_QUOTE_TEMPLATE_LANGUAGE=en
# Inbound webhook (Meta will call /api/whatsapp):
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
