{
  "name": "notofire-import-tower",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--use-system-ca next dev",
    "build": "next build",
    "start": "cross-env NODE_OPTIONS=--use-system-ca next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:setup": "node scripts/setup-supabase.mjs",
    "db:apply": "node scripts/apply-migrations.mjs",
    "db:verify": "node scripts/verify-db.mjs",
    "auth:configure": "node scripts/configure-auth.mjs",
    "auth:seed": "node scripts/seed-admin.mjs",
    "auth:allow": "node scripts/authorize-operator.mjs",
    "auth:link": "node scripts/signin-link.mjs",
    "archive:scan": "node scripts/scan-archive.mjs",
    "archive:load": "node scripts/load-archive.mjs",
    "archive:drive": "node scripts/backfill-drive-links.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.111.0",
    "clsx": "^2.1.1",
